<launch>
	<arg name="robot_name" default="simpleArm" description="URDF file name without extension (simpleArm|advancedArm|manipulator)"/>

	<node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
		<param name="robot_description"	value="$(command 'cat $(find-pkg-share rrm_simple_robot_model)/urdf/$(var robot_name).urdf')"/>
	</node>
	<node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="$(find-pkg-share rrm_simple_robot_model)/config/rrm_cv3.rviz"/>
</launch>
